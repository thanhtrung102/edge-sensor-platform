# Copy to .env and adjust. All have sensible defaults for a local demo.
DEVICE_ID=edge-001
SITE=hanoi-lab
CAPTURE_FPS=2
# synthetic = no hardware needed (default); webcam = real USB camera (run agent natively, not in Docker on Windows)
CAMERA_SOURCE=synthetic
# Local store-and-forward buffer cap; past this, oldest buffered files are dropped (newest wins)
MAX_BUFFER_BYTES=536870912

S3_BUCKET=edge-data
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

GRAFANA_PASSWORD=admin
